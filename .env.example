# ─────────────────────────────────────────────
# Samba AD DC — Docker Configuration
# Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────

# Kerberos realm (must be UPPERCASE)
REALM=LAB.INTERNAL

# NetBIOS domain name
DOMAIN=LAB

# Domain Administrator password
ADMIN_PASSWORD=Admin.1.samba

# DNS forwarder for external name resolution
DNS_FORWARDER=8.8.8.8

# Hostname for the Domain Controller
SAMBA_HOSTNAME=dc1

# ─────────────────────────────────────────────
# Test Users
# ─────────────────────────────────────────────

# Set to "true" to create sample users on first start
CREATE_TEST_USERS=true

# Default password pattern for test users: <username>.1.Samba
# (e.g. testuser → testuser.1.Samba)
TEST_USER_PASSWORD_SUFFIX=.1.Samba

# Lockout policy
LOCKOUT_THRESHOLD=3
LOCKOUT_DURATION=5
LOCKOUT_OBSERVATION_WINDOW=5
